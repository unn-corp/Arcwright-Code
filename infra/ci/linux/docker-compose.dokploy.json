{
  "name": "__T3_SLOT__",
  "networks": {
    "isolated": {
      "name": "__T3_SLOT___isolated",
      "ipam": {
        "config": [
          {
            "subnet": "__T3_SUBNET__",
            "gateway": "__T3_GATEWAY__"
          }
        ]
      },
      "enable_ipv6": false,
      "driver": "bridge",
      "driver_opts": {
        "com.docker.network.bridge.name": "__T3_BRIDGE__"
      }
    }
  },
  "secrets": {
    "github-app-private-key": {
      "name": "__T3_SLOT___github-app-private-key",
      "file": "/etc/ci-runner/secrets/github_app_private_key"
    }
  },
  "services": {
    "prepare": {
      "profiles": ["pair"],
      "command": ["set -euo pipefail; install -d -m 0750 -o 1001 -g 121 /runner-work"],
      "entrypoint": ["/bin/bash", "-c"],
      "image": "__T3_RUNNER_IMAGE__",
      "networks": {
        "isolated": null
      },
      "read_only": true,
      "restart": "no",
      "tmpfs": ["/tmp:rw,noexec,nosuid,nodev,size=64m", "/run:rw,nosuid,nodev,size=32m"],
      "user": "0:0",
      "volumes": [
        {
          "type": "volume",
          "source": "runner-work",
          "target": "/runner-work",
          "volume": {}
        }
      ],
      "pull_policy": "never"
    },
    "register": {
      "profiles": ["pair"],
      "command": [
        "set -euo pipefail; app_key=\"$$(cat /run/secrets/github-app-private-key)\"; access_token=\"$$(APP_ID=\"$${GITHUB_APP_ID}\" APP_PRIVATE_KEY=\"$$app_key\" APP_LOGIN=\"$${GITHUB_ORG}\" bash /app_token.sh)\"; runner_token=\"$$(ACCESS_TOKEN=\"$$access_token\" bash /token.sh | jq -er '.token')\"; unset app_key access_token; test -n \"$$runner_token\"; /actions-runner/config.sh --url \"https://github.com/$${GITHUB_ORG}\" --token \"$$runner_token\" --name \"$${RUNNER_NAME}\" --work \"$${RUNNER_WORKDIR}\" --labels \"$${RUNNER_LABELS}\" --runnergroup \"$${RUNNER_GROUP}\" --unattended --replace --ephemeral --disableupdate; unset runner_token; chown -R 1001:121 /actions-runner"
      ],
      "depends_on": {
        "prepare": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "entrypoint": ["/bin/bash", "-c"],
      "environment": {
        "GITHUB_APP_ID": "3977061",
        "GITHUB_ORG": "unn-corp",
        "ORG_NAME": "unn-corp",
        "RUNNER_ALLOW_RUNASROOT": "1",
        "RUNNER_GROUP": "T3 Code",
        "RUNNER_LABELS": "unn-isolated,unn,t3-ci",
        "RUNNER_NAME": "__T3_SLOT__",
        "RUNNER_SCOPE": "org",
        "RUNNER_WORKDIR": "/_work"
      },
      "image": "__T3_RUNNER_IMAGE__",
      "networks": {
        "isolated": null
      },
      "read_only": true,
      "restart": "no",
      "secrets": [
        {
          "source": "github-app-private-key",
          "target": "/run/secrets/github-app-private-key"
        }
      ],
      "tmpfs": ["/tmp:rw,noexec,nosuid,nodev,size=64m", "/run:rw,nosuid,nodev,size=32m"],
      "user": "0:0",
      "volumes": [
        {
          "type": "volume",
          "source": "runner-state",
          "target": "/actions-runner",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "runner-work",
          "target": "/_work",
          "volume": {}
        }
      ],
      "pull_policy": "never"
    },
    "runner": {
      "profiles": ["pair"],
      "cap_drop": ["ALL"],
      "command": ["exec /usr/local/bin/t3-ci-start-runner"],
      "depends_on": {
        "register": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "deploy": {
        "replicas": 1,
        "resources": {
          "limits": {
            "cpus": 8,
            "memory": "17179869184",
            "pids": 512
          }
        },
        "placement": {}
      },
      "entrypoint": ["/bin/bash", "-c"],
      "environment": {
        "EPHEMERAL": "true",
        "LABELS": "unn-isolated,unn,t3-ci",
        "RUNNER_WORKDIR": "/_work"
      },
      "image": "__T3_RUNNER_IMAGE__",
      "networks": {
        "isolated": null
      },
      "read_only": true,
      "restart": "no",
      "security_opt": ["no-new-privileges:true"],
      "stop_grace_period": "30s",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=256m",
        "/run:rw,nosuid,nodev,size=64m",
        "/opt/hostedtoolcache:rw,exec,nosuid,nodev,size=2g,mode=0750,uid=1001,gid=121",
        "/home/runner:rw,exec,nosuid,nodev,size=2g,mode=0750,uid=1001,gid=121"
      ],
      "user": "1001:121",
      "volumes": [
        {
          "type": "volume",
          "source": "runner-state",
          "target": "/actions-runner",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "runner-work",
          "target": "/_work",
          "volume": {}
        }
      ],
      "pull_policy": "never",
      "group_add": ["994"],
      "devices": ["/dev/kvm:/dev/kvm"],
      "sysctls": {
        "net.ipv6.conf.all.disable_ipv6": "1",
        "net.ipv6.conf.default.disable_ipv6": "1"
      }
    },
    "supervisor": {
      "cap_drop": ["ALL"],
      "command": null,
      "entrypoint": ["/bin/sh", "/opt/runner-supervisor/dokploy-supervisor.sh"],
      "environment": {
        "CI_RUNNER_COMPOSE_FILE": "/etc/dokploy/compose/__T3_SLOT__/code/docker-compose.yml",
        "CI_RUNNER_PROJECT": "__T3_SLOT__",
        "CI_RUNNER_HOST_PUBLIC_IP": "67.222.144.10",
        "CI_RUNNER_SUBNET": "__T3_SUBNET__",
        "CI_RUNNER_GATEWAY": "__T3_GATEWAY__",
        "CI_RUNNER_HELPER_IMAGE": "__T3_RUNNER_IMAGE__",
        "CI_RUNNER_MAX_SECONDS": "28800",
        "HOME": "/tmp",
        "TMPDIR": "/tmp",
        "DOCKER_CONFIG": "/tmp/docker",
        "XDG_CACHE_HOME": "/tmp/cache",
        "XDG_CONFIG_HOME": "/tmp/config"
      },
      "healthcheck": {
        "test": ["CMD-SHELL", "test -S /var/run/docker.sock && kill -0 1"],
        "timeout": "5s",
        "interval": "30s",
        "retries": 3
      },
      "image": "__T3_RUNNER_IMAGE__",
      "network_mode": "none",
      "pids_limit": 128,
      "read_only": true,
      "restart": "unless-stopped",
      "security_opt": ["no-new-privileges:true"],
      "stop_grace_period": "1m30s",
      "tmpfs": ["/tmp:rw,noexec,nosuid,nodev,size=16m", "/run:rw,noexec,nosuid,nodev,size=8m"],
      "user": "0:0",
      "volumes": [
        {
          "type": "bind",
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/etc/dokploy/compose/__T3_SLOT__/code",
          "target": "/etc/dokploy/compose/__T3_SLOT__/code",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/devotek/t3-ci-build/infra/ci/linux",
          "target": "/opt/runner-supervisor",
          "read_only": true,
          "bind": {}
        }
      ],
      "pull_policy": "never"
    }
  },
  "volumes": {
    "runner-state": {
      "name": "__T3_SLOT___runner-state"
    },
    "runner-work": {
      "name": "__T3_SLOT___runner-work"
    }
  }
}
